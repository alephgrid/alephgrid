# Copy to .env next to compose.yaml and fill in. Keep .env out of version control: it can hold
# the admin password and the single sign-on secret.

# Required: the host name people use. Its DNS must point at this machine.
ALEPHGRID_DOMAIN=grid.example.com

# The image version to run (pin it; see docs/OPERATIONS.md, "Upgrades").
ALEPHGRID_VERSION=0.1.0

# Optional: create the first instance admin on the first start (only while there are no
# users). Leave empty to use the one-time setup code from `docker compose logs alephgrid`.
# Remove the password once the admin exists.
ALEPHGRID_ADMIN_EMAIL=
ALEPHGRID_ADMIN_PASSWORD=

# Container limits for Alephgrid. DuckDB uses 80% of the memory limit unless
# ALEPHGRID_MEMORY_BUDGET is set in compose.yaml.
ALEPHGRID_MEMORY=8g
ALEPHGRID_CPUS=4

# Single sign-on (uncomment the matching lines in compose.yaml too; docs/TEAMS.md).
# ALEPHGRID_OIDC_ISSUER=https://login.example.com
# ALEPHGRID_OIDC_CLIENT_ID=alephgrid
# ALEPHGRID_OIDC_CLIENT_SECRET=
