---
import SiteLayout from '../components/SiteLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}`;
const repo = 'https://github.com/alephgrid/alephgrid';
---

<SiteLayout title="Contribute to Alephgrid" description="Code, docs, tests and design contributions to the open-source Alephgrid spreadsheet.">
  <main id="main">
    <header class="ag-pagehead">
      <div class="ag-container">
        <h1>Contribute to Alephgrid</h1>
        <p class="ag-lead">
          Alephgrid is Apache-2.0 and developed in the open: a Rust server embedding DuckDB, an
          Excel-compatible formula engine and a TypeScript canvas client. Code, documentation,
          tests, bug reports and design review all count.
        </p>
        <div class="ag-actions" style="margin-top:1.75rem">
          <a class="ag-button" href={`${repo}/blob/main/CONTRIBUTING.md`}>Read the contributing guide</a>
          <a class="ag-button ag-secondary" href={`${repo}/issues`}>Browse open issues</a>
        </div>
      </div>
    </header>

    <section class="ag-page-section" aria-labelledby="how-title">
      <div class="ag-container">
        <h2 id="how-title" class="sr-only">How to contribute</h2>
        <div class="ag-topics">
          <div>
            <h3>Start here</h3>
            <p>
              Read the <a href={`${repo}/blob/main/CONTRIBUTING.md`}>contributing guide</a> and the
              <a href={`${repo}/blob/main/CODE_OF_CONDUCT.md`}>code of conduct</a>, then build from
              source with the <a href={url('/docs/getting-started/')}>getting-started guide</a>.
            </p>
          </div>
          <div>
            <h3>Find work</h3>
            <p>
              Browse <a href={`${repo}/issues`}>open issues</a>. A bug report with a workbook or
              file that reproduces it is as valuable as a fix. The
              <a href={`${repo}/blob/main/docs/SPREADSHEET_FEATURES.md`}>feature inventory</a>
              shows what is shipped, partial or not planned.
            </p>
          </div>
          <div>
            <h3>Quality bar</h3>
            <p>
              Changes come with tests. The test strategy and CI setup are in the repository:
              <a href={`${repo}/blob/main/docs/TEST_STRATEGY.md`}>TEST_STRATEGY.md</a> and
              <a href={`${repo}/blob/main/docs/CI.md`}>CI.md</a>.
            </p>
          </div>
          <div>
            <h3>Security</h3>
            <p>
              Report vulnerabilities privately as described in
              <a href={`${repo}/blob/main/SECURITY.md`}>SECURITY.md</a>, never in a public issue.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
