---
import SiteLayout from '../components/SiteLayout.astro';
import releases from '../data/releases.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}`;
const planned = releases.channels.filter((c) => !c.published);
---

<SiteLayout title="Install Alephgrid" description="Build Alephgrid from source today; native binaries, package managers and container images arrive with v0.1.0.">
  <main>
    <section class="ag-hero" style="padding-bottom:1rem">
      <div class="ag-container">
        <p class="ag-kicker"><span class="ag-ref"><b>{releases.current.label}</b></span></p>
        <h1>Install Alephgrid</h1>
        <p class="ag-sub">
          Alephgrid is pre-release. The ready path today is building from source on macOS or
          Linux (on Windows, use Docker or WSL). Every channel below flips to ready only when its
          artifacts exist, are checksummed and have passed a clean-machine install.
        </p>
      </div>
    </section>

    <section class="ag-section" style="padding-top:1rem">
      <div class="ag-container">
        <h2>Build from source</h2>
        <p class="ag-lead">Requires Rust 1.88+ and Node 20+. The first build compiles DuckDB from source, which takes several minutes.</p>
        <div class="ag-code-wrap">
          <pre class="ag-code">git clone https://github.com/alephgrid/alephgrid &amp;&amp; cd alephgrid
(cd web &amp;&amp; npm install &amp;&amp; npm run build)
cargo build --release
./target/release/alephgrid --demo-rows 10000000</pre>
          <button class="ag-copy" data-copy>Copy</button>
        </div>
        <p class="ag-caption" style="text-align:left">
          The server prints its URL (default <code>http://127.0.0.1:7878</code>) and stores data in
          <code>./alephgrid-data</code>. On your own machine there is no sign-in and it listens on
          loopback only. First steps: <a href={url('/docs/getting-started/')}>getting started</a>.
        </p>
      </div>
    </section>

    <section class="ag-section">
      <div class="ag-container">
        <h2>Planned channels</h2>
        <p class="ag-lead">
          These are tracked on the <a href={url('/releases/')}>releases page</a> and enabled one by
          one as v0.1.0 artifacts pass verification. No command appears here until it actually works.
        </p>
        <table class="ag-table">
          <thead>
            <tr><th scope="col">Channel</th><th scope="col">Status</th></tr>
          </thead>
          <tbody>
            {planned.map((c) => (
              <tr>
                <td>{c.name}</td>
                <td><span class="ag-status planned">Planned</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</SiteLayout>
