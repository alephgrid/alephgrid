---
import SiteLayout from '../components/SiteLayout.astro';
import releases from '../data/releases.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}`;
const repo = 'https://github.com/alephgrid/alephgrid';
---

<SiteLayout title="Alephgrid releases" description="Release notes, versioning policy and channel readiness for Alephgrid.">
  <main id="main">
    <header class="ag-pagehead">
      <div class="ag-container">
        <h1>Releases</h1>
        <p class="ag-lead">
          Versions follow <a href="https://semver.org">Semantic Versioning</a>. Before 1.0 a minor
          version may change the storage format; such versions migrate workbooks on open and keep
          the old file. Only the latest release receives fixes.
        </p>
      </div>
    </header>

    <section class="ag-page-section" aria-labelledby="next-title">
      <div class="ag-container">
        <h2 id="next-title">v0.1.0, released 9 November 2026</h2>
        <p class="ag-lead">
          The first release: binaries for Linux and macOS, npm and PyPI packages and a Docker image,
          all built from the same tested commit. The full list is in the
          <a href={`${repo}/blob/main/CHANGELOG.md`}>CHANGELOG</a> and on the
          <a href={`${repo}/releases/tag/v0.1.0`}>GitHub release</a>; these are the highlights.
        </p>
        <div class="ag-actions" style="margin:0 0 2rem">
          <a class="ag-button" href={url('/install/')}>Install v0.1.0</a>
          <a class="ag-button ag-secondary" href={`${repo}/releases/tag/v0.1.0`}>Release on GitHub</a>
        </div>
        <div class="ag-topics">
          <div>
            <h3>Sheets</h3>
            <p>Excel-syntax formulas with cross-sheet references, formatting, merged cells, frozen panes, charts with preview, colour rules, comments, the fill handle, find and replace, XLSX import and export.</p>
          </div>
          <div>
            <h3>Big tables</h3>
            <p>A virtual grid that fetches only the rows on screen, typed edits, calculated columns, multi-column sort and filters, the Analyze pane for pivots and profiles, reviewed streaming imports.</p>
          </div>
          <div>
            <h3>Functions and SQL</h3>
            <p>Reusable functions as formulas, SQL or sandboxed Python with tests and versions; a dockable SQL workspace with autocomplete, parameters and saved queries.</p>
          </div>
          <div>
            <h3>Teams and agents</h3>
            <p>Spaces, roles, password or OpenID Connect sign-in, quotas, audit, backups, and read-only MCP access for AI agents with content-hashed receipts.</p>
          </div>
          <div>
            <h3>Security</h3>
            <p>Includes the fixes from the 31 October 2026 security audit. Report issues as described in <a href={`${repo}/blob/main/SECURITY.md`}>SECURITY.md</a>.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="ag-page-section" aria-labelledby="channels-title">
      <div class="ag-container">
        <h2 id="channels-title">Channel readiness</h2>
        <p class="ag-lead">
          Downloads on this site come from a release manifest with artifact URLs and SHA-256
          checksums. A channel is marked ready only once its published artifacts install and run.
        </p>
        <div class="ag-table-wrap" role="region" aria-label="Channel readiness table" tabindex="0">
          <table class="ag-table">
            <thead>
              <tr><th scope="col">Channel</th><th scope="col">Status</th><th scope="col">Notes</th></tr>
            </thead>
            <tbody>
              {releases.channels.map((c) => (
                <tr>
                  <td>{c.name}</td>
                  <td>
                    {c.published
                      ? <span class="ag-status ready">{c.id === 'source' ? 'Ready' : `v${releases.current.version}`}</span>
                      : <span class="ag-status planned">Planned</span>}
                  </td>
                  <td class="ag-muted">{c.published ? (c.requires ?? c.notes ?? '') : (c.notes ?? '')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="ag-note">
          Upgrade and rollback guidance is in the
          <a href={`${repo}/blob/main/docs/OPERATIONS.md`}>operations guide</a>. To install, see the
          <a href={url('/install/')}>install page</a>.
        </p>
      </div>
    </section>
  </main>
</SiteLayout>
